<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white_ffffff"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/rl_title"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:background="@color/blue_2f84d0">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="停车监控"
            android:textColor="@color/white_ffffff"
            android:textSize="18sp" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:orientation="horizontal"
        android:paddingLeft="10dp"
        android:paddingRight="10dp">

        <EditText
            android:id="@+id/etNum"
            android:layout_width="0px"
            android:layout_height="match_parent"
            android:layout_marginRight="15dp"
            android:layout_weight="1"
            android:gravity="center"
            android:hint="连续次数如：2"
            android:inputType="number"
            android:textColor="@color/black_333333"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etDistance"
            android:layout_width="0px"
            android:layout_height="match_parent"
            android:layout_marginLeft="15dp"
            android:layout_weight="1.2"
            android:gravity="center"
            android:hint="有效距离（米）如：1.5"
            android:inputType="numberDecimal|number"
            android:textColor="@color/black_333333"
            android:textSize="15sp" />
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp">

        <EditText
            android:id="@+id/etMacMoko"
            android:layout_width="0px"
            android:layout_height="45dp"
            android:digits="0123456789abcdefABCDEF"
            android:gravity="center"
            android:hint="mac地址"
            android:maxLength="12"
            android:textColor="@color/black_333333"
            android:textSize="15sp"
            app:layout_constraintLeft_toLeftOf="@+id/tvStatusMoko"
            app:layout_constraintRight_toRightOf="@+id/tvStatusMoko" />

        <TextView
            android:id="@+id/tvMacMoko"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:textColor="@color/black_333333"
            android:textSize="14sp"
            app:layout_constraintLeft_toLeftOf="@+id/tvStatusMoko"
            app:layout_constraintRight_toRightOf="@+id/tvStatusMoko"
            app:layout_constraintTop_toBottomOf="@+id/etMacMoko"
            tools:text="AC:13:78:DE:AE:63" />

        <TextView
            android:id="@+id/tvStatusMoko"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="5dp"
            android:background="@drawable/shape_radius6_green"
            android:gravity="center"
            android:text="空闲"
            android:textColor="@color/white_ffffff"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvMacMoko" />

        <TextView
            android:id="@+id/tvResultMoko"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:textColor="@color/black_333333"
            android:textSize="14sp"
            app:layout_constraintLeft_toLeftOf="@+id/tvStatusMoko"
            app:layout_constraintRight_toRightOf="@+id/tvStatusMoko"
            app:layout_constraintTop_toBottomOf="@+id/tvStatusMoko"
            tools:text="1-2-3" />

        <TextView
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:text="公司产品"
            android:textColor="@color/black_333333"
            android:textSize="15sp"
            app:layout_constraintLeft_toLeftOf="@+id/tvStatusMoko"
            app:layout_constraintRight_toRightOf="@+id/tvStatusMoko"
            app:layout_constraintTop_toBottomOf="@+id/tvResultMoko" />


        <EditText
            android:id="@+id/etMacOther"
            android:layout_width="0px"
            android:layout_height="45dp"
            android:digits="0123456789abcdefABCDEF"
            android:gravity="center"
            android:hint="mac地址"
            android:maxLength="12"
            android:textColor="@color/black_333333"
            android:textSize="15sp"
            app:layout_constraintLeft_toLeftOf="@+id/tvStatusOther"
            app:layout_constraintRight_toRightOf="@+id/tvStatusOther" />

        <TextView
            android:id="@+id/tvMacOther"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:textColor="@color/black_333333"
            android:textSize="14sp"
            app:layout_constraintLeft_toLeftOf="@+id/tvStatusOther"
            app:layout_constraintRight_toRightOf="@+id/tvStatusOther"
            app:layout_constraintTop_toBottomOf="@+id/etMacOther"
            tools:text="AC:13:78:DE:AE:63" />

        <TextView
            android:id="@+id/tvStatusOther"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginTop="5dp"
            android:layout_marginRight="20dp"
            android:background="@drawable/shape_radius6_green"
            android:gravity="center"
            android:text="空闲"
            android:textColor="@color/white_ffffff"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvMacOther" />

        <TextView
            android:id="@+id/tvResultOther"
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:textColor="@color/black_333333"
            android:textSize="14sp"
            app:layout_constraintLeft_toLeftOf="@+id/tvStatusOther"
            app:layout_constraintRight_toRightOf="@+id/tvStatusOther"
            app:layout_constraintTop_toBottomOf="@+id/tvStatusOther"
            tools:text="1-2-3" />

        <TextView
            android:layout_width="0px"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:text="竞品产品"
            android:textColor="@color/black_333333"
            android:textSize="15sp"
            app:layout_constraintLeft_toLeftOf="@+id/tvStatusOther"
            app:layout_constraintRight_toRightOf="@+id/tvStatusOther"
            app:layout_constraintTop_toBottomOf="@+id/tvResultOther" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <Button
        android:id="@+id/btnStart"
        android:layout_width="150dp"
        android:layout_height="45dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="50dp"
        android:background="@drawable/shape_radius_blue_btn_bg"
        android:text="开始扫描"
        android:textColor="@color/white_ffffff"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>